<Window x:Class="RetailPrint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retail Print"
        Icon="Assets/RetailPrint.ico"
        Width="430"
        Height="680"
        MinWidth="430"
        MaxWidth="430"
        MinHeight="620"
        MaxHeight="760"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#F5F6F8"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="BorderBrush" Value="#D4D8DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#D4D8DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Margin="12" Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Retail Print" FontSize="19" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock Text="Máy in tại quầy" Margin="0,2,0,0" FontSize="12" Foreground="#6B7280" />
                    </StackPanel>
                    <Border x:Name="RetailStatusBadge" Grid.Column="1" Padding="9,5" CornerRadius="12" Background="#EEF2F7" VerticalAlignment="Center">
                        <TextBlock x:Name="RetailStatusText" Text="Đang kết nối…" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" />
                    </Border>
                </Grid>

                <TextBlock Text="Cách kết nối máy in" Style="{StaticResource LabelStyle}" Margin="0,18,0,5" />
                <Border Padding="10" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="7">
                    <StackPanel>
                        <RadioButton x:Name="WindowsPrinterRadio" Content="Máy in trên Windows" GroupName="ConnectionMode" FontWeight="SemiBold" Checked="ConnectionMode_Checked" />
                        <TextBlock Text="Dùng máy in đã được cài trong Printers &amp; scanners của Windows." Margin="22,3,0,10" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
                        <RadioButton x:Name="NetworkPrinterRadio" Content="Máy in mạng trực tiếp" GroupName="ConnectionMode" FontWeight="SemiBold" Checked="ConnectionMode_Checked" />
                        <TextBlock Text="Dùng cho máy in có địa chỉ mạng riêng, không cần cắm USB vào máy tính." Margin="22,3,0,0" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="WindowsPrinterPanel" Margin="0,14,0,0">
                    <TextBlock Text="Máy in Windows" Style="{StaticResource LabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="WindowsPrinterComboBox" Height="34" Padding="7,3" VerticalContentAlignment="Center" />
                        <Button x:Name="RefreshPrintersButton" Grid.Column="2" Content="Làm mới" MinWidth="82" Height="34" Style="{StaticResource SecondaryButton}" Click="RefreshPrintersButton_Click" />
                    </Grid>
                </StackPanel>

                <Grid x:Name="NetworkPrinterPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="95" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Địa chỉ máy in" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="IpTextBox" Style="{StaticResource InputStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cổng" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="PortTextBox" Style="{StaticResource InputStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Khổ giấy" Style="{StaticResource LabelStyle}" />
                        <Border Height="38" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="7" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="Paper80Radio" Content="80 mm" GroupName="Paper" Margin="0,0,24,0" />
                                <RadioButton x:Name="Paper58Radio" Content="58 mm" GroupName="Paper" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <CheckBox x:Name="StartupCheckBox" Grid.Column="2" Content="Mở cùng Windows" VerticalAlignment="Bottom" Margin="0,0,0,9" Foreground="#374151" />
                </Grid>

                <Border Margin="0,16,0,0" Padding="11" CornerRadius="8" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Mã kết nối Retail" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock Text="Mã cố định của máy Windows này. Điện thoại Retail nào cũng nhập cùng mã." Margin="0,2,0,8" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
                        <TextBlock x:Name="PairingCodeText" Text="Đang tải mã…" FontSize="22" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock x:Name="PairingHintText" Text="Mã không mất sau khi kết nối và không cần lấy lại." Margin="0,3,0,0" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="TestButton" Grid.Column="0" Content="In thử" Style="{StaticResource SecondaryButton}" Click="TestButton_Click" />
                    <Button x:Name="SaveButton" Grid.Column="2" Content="Lưu" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
                </Grid>

                <Border Margin="0,14,0,0" Padding="10,8" CornerRadius="7" Background="#F8FAFC">
                    <TextBlock x:Name="PrinterStatusText" Text="Chọn máy in, in thử rồi lưu. Đóng cửa sổ vẫn giữ Retail Print chạy; mở shortcut để hiện lại." FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="Cấu hình máy in chỉ lưu trên máy Windows này." Margin="0,10,0,0" FontSize="10.5" Foreground="#9CA3AF" HorizontalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
